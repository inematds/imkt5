# ─── Gateway ─────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# ─── Redis (fila de jobs) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Storage de memória conversacional ───────────────────
# SQLite file; um arquivo no core. Separações por tenant acontecem via coluna tenant_id.
MEMORY_DB_PATH=./data/memory.db

# ─── Postgres (Gateway — jobs, usuários, auditoria) ──────
POSTGRES_URL=postgresql://imkt4:imkt4@localhost:5432/imkt4

# ─── Object storage (MinIO/S3) ───────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=imkt4
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ─── Providers LLM ───────────────────────────────────────
OPENROUTER_API_KEY=
OLLAMA_URL=http://localhost:11434

# ─── Canais ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
WHATSAPP_DAEMON_URL=http://localhost:4242

# ─── Secrets (KMS externo — placeholders para produção) ──
# Em produção, use Vault/AWS KMS. Não commitar chaves reais.
KMS_PROVIDER=local
LOCAL_SECRETS_KEY=change-me-in-prod
