# ─── Gateway ─────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# ─── Redis (fila de jobs) ────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Storage de memória conversacional ───────────────────
# SQLite file; um arquivo no core. Separações por tenant acontecem via coluna tenant_id.
MEMORY_DB_PATH=./data/memory.db

# ─── Postgres (Gateway — jobs, usuários, auditoria) ──────
POSTGRES_URL=postgresql://imkt4:imkt4@localhost:5432/imkt4

# ─── Object storage (MinIO/S3) ───────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=imkt4
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Ativar S3/MinIO: IMKT4_STORAGE=s3 (default: local)
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=imkt4-artifacts
# S3_PUBLIC_BASE=http://localhost:9000   # opcional, usa presigned se vazio

# ─── Providers LLM ───────────────────────────────────────
# Ordem de fallback (csv). Providers sem credencial são pulados.
LLM_PROVIDER_ORDER=claude_code,ollama,openrouter

# claude_code: usa o CLI `claude` já logado em ~/.claude/ (sem API key).
CLAUDE_CODE_MODEL=claude-haiku-4-5

# ollama local
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# openrouter (fallback pago)
OPENROUTER_API_KEY=

# ─── Canais ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
WHATSAPP_DAEMON_URL=http://localhost:4242

# ─── Secrets (KMS externo — placeholders para produção) ──
# Em produção, use Vault/AWS KMS. Não commitar chaves reais.
KMS_PROVIDER=local
LOCAL_SECRETS_KEY=change-me-in-prod
